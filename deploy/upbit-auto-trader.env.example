APP_DIR=/opt/upbit-auto-trader

UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=
UPBIT_BASE_URL=https://api.upbit.com
UPBIT_LIVE_TRADING=true
AUTO_ALLOW_FULL_BALANCE=true

MAX_ORDER_KRW=10000
MIN_ORDER_KRW=5000

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT_SECONDS=60
AI_NEWS_FEEDS=
AI_EXTRA_NEWS_FEEDS=
AI_NEWS_QUERIES=
AI_EXTRA_NEWS_QUERIES=

ALERTS_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=

AUTO_TRADER_ARGS=run-auto --live --yes --allow-full-balance --cash-usage-percent 100 --interval-seconds 28800 --position-check-seconds 10 --use-openai-info --info-article-limit 200 --max-change-rate 0.12 --overheat-info-threshold 0.50 --min-info-articles-for-buy 1 --min-info-score-for-buy 0 --candidate-news-markets 10 --candidate-news-articles-per-market 10 --stop-loss-rate -0.06 --min-profit-exit-rate 0.05 --trailing-start-rate 0.05 --rotation-min-pnl-rate 0.05 --alert-heartbeat-cycles 1
STATUS_WEB_ARGS=status-web --host 127.0.0.1 --port 8080
