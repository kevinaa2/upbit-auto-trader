# Copy this file to .env for local PyCharm runs.
# Never commit .env. It is already ignored by Git.

UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=
UPBIT_BASE_URL=https://api.upbit.com

# Keep false until you intentionally test real orders.
UPBIT_LIVE_TRADING=false
MAX_ORDER_KRW=10000
MIN_ORDER_KRW=5000
AUTO_ALLOW_FULL_BALANCE=false

AI_NEWS_FEEDS=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

ALERTS_ENABLED=false
ALERT_WEBHOOK_URL=
